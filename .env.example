# =========================================================
# Kelvin Ikpeni Code Academy — Environment Template
# Copy to .env and fill with real values.
# =========================================================

# --- Server ---
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kica?retryWrites=true&w=majority

# --- Sessions ---
SESSION_SECRET=replace-with-a-48-byte-hex-string
SESSION_NAME=kica.sid
SESSION_MAX_AGE_MS=604800000
COOKIE_SECURE=false

# --- Base URL (for certificate verify links) ---
BASE_URL=http://localhost:3000

# --- Initial seed data ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_NAME=Kelvin Ikpeni
STUDENT_EMAIL=student@example.com
STUDENT_PASSWORD=replace-with-strong-password
STUDENT_NAME=Demo Student